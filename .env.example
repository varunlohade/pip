# Email codes (sign-up, password reset, add email). Without RESEND_API_KEY the server sends nothing and only logs the kind.
RESEND_API_KEY=
# Required when RESEND_API_KEY is set. A sender on a domain verified in Resend.
MAIL_FROM="Pip <hello@example.com>"
# Private AI on NEAR (see README). With NEARAI_API_KEY set, writing help and explain run in NEAR AI Cloud TEEs;
# OPENROUTER_API_KEY is the fallback. At least one of the two is needed.
NEARAI_API_KEY=
# Optional: NEAR model ids. Defaults: Qwen/Qwen3.6-35B-A3B-FP8 and z-ai/glm-5.3-flash.
NEARAI_MODEL_PRIMARY=
NEARAI_MODEL_FALLBACK=
