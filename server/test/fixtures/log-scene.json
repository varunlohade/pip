{
  "title": "y = log(x)",
  "steps": [
    {
      "say": "Start with a graph: x goes right, y goes up.",
      "shapes": [
        {
          "type": "axes",
          "x": 60,
          "y": 40,
          "w": 700,
          "h": 430,
          "x_min": 0,
          "x_max": 10.5,
          "y_min": -1.3,
          "y_max": 1.3,
          "x_label": "x",
          "y_label": "y"
        }
      ]
    },
    {
      "say": "Draw y = log(x). It climbs fast near 0, then slows down.",
      "shapes": [
        {
          "type": "plot",
          "fn": "log10",
          "color": "blue"
        }
      ]
    },
    {
      "say": "At x = 1 the log is 0, because 10 to the power 0 is 1.",
      "shapes": [
        {
          "type": "ellipse",
          "x": 119,
          "y": 247,
          "w": 16,
          "h": 16,
          "color": "blue"
        },
        {
          "type": "arrow",
          "x1": 146,
          "y1": 336,
          "x2": 129,
          "y2": 268,
          "color": "black"
        },
        {
          "type": "text",
          "x": 128,
          "y": 340,
          "text": "(1, 0)",
          "size": "m",
          "color": "black"
        }
      ]
    },
    {
      "say": "Past 1 it climbs slowly. x = 10 only gets you to 1.",
      "shapes": [
        {
          "type": "text",
          "x": 250,
          "y": 58,
          "text": "climbs, but slowly",
          "size": "m",
          "color": "blue"
        },
        {
          "type": "ellipse",
          "x": 719,
          "y": 82,
          "w": 16,
          "h": 16,
          "color": "blue"
        }
      ]
    }
  ]
}
